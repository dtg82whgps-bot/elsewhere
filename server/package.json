{
  "name": "elsewhere-server",
  "version": "1.0.0",
  "private": true,
  "description": "Elsewhere analysis API. Holds the Anthropic API key; the mobile app never does.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "smoke": "tsx scripts/live-smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
