# Required. Create a key at https://console.anthropic.com/ and keep it on the server only.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5-5.
ELSEWHERE_MODEL=claude-opus-5-5
# Recommended in production so research tokens survive restarts. Any long random string.
RESEARCH_SIGNING_KEY=
# Optional. Comma-separated browser origins allowed to call the API (web preview only). Leave empty for native apps.
ALLOWED_ORIGINS=
PORT=8080
